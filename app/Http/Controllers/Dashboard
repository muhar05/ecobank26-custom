<?php

namespace App\Http\Controllers;

use App\Models\Sale;
use App\Models\SavingsLedger;
use App\Models\WasteBankCashLedger;
use App\Models\WasteCustomer;

class DashboardController extends Controller
{
    public function bankSampah()
    {
        $totalCustomers = WasteCustomer::count();
        $totalCredit = SavingsLedger::where('type', 'credit')->sum('amount');
        $totalDebit = SavingsLedger::where('type', 'debit')->sum('amount');
        $totalSales = Sale::sum('total_amount');
        $wasteBankCashBalance = WasteBankCashLedger::latest('id')->value('balance') ?? 0;
        $recentLedgers = SavingsLedger::with('wasteCustomer')
            ->latest('id')->limit(5)->get();
        $recentCashLedgers = WasteBankCashLedger::latest('id')->limit(5)->get();

        return view('dashboard.admin-bank-sampah', [
            'totalCustomers' => $totalCustomers,
            'totalSavings' => $totalCredit - $totalDebit,
            'totalCredit' => $totalCredit,
            'totalDebit' => $totalDebit,
            'totalSales' => $totalSales,
            'wasteBankCashBalance' => $wasteBankCashBalance,
            'recentLedgers' => $recentLedgers,
            'recentCashLedgers' => $recentCashLedgers,
        ]);
    }
}